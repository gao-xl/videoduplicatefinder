<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Material Design 动画效果 ===== -->

    <!-- DataGrid row hover -->
    <Style Selector="DataGridRow">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource RowHoverBackground}" />
    </Style>

    <!-- Metric hover diff -->
    <Style Selector="TextBlock.metric-diff">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Skeleton shimmer loading animation -->
    <Style Selector="Border.skeleton-shimmer">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.4" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.8" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Fade-in animation -->
    <Style Selector="Border.fade-in">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseInOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Scale hover -->
    <Style Selector="Border.scale-hover">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseInOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Slide-in from bottom -->
    <Style Selector="Border.slide-up">
        <Setter Property="RenderTransformOrigin" Value="0.5,1" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="QuadraticEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut" />
            </Transitions>
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="QuadraticEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="RenderTransform" Value="translate(0,12)" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="translate(0,0)" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Expand/collapse transition -->
    <Style Selector="Border.expand-collapse">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Button press animation -->
    <Style Selector="Button.press-effect">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.press-effect:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- Material Design ripple container -->
    <Style Selector="Border.ripple-container">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Elevation hover -->
    <Style Selector="Border.elevate-hover">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Checkbox check animation -->
    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Tab transition -->
    <Style Selector="TabControl">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Progress bar indeterminate animation -->
    <Style Selector="ProgressBar.indeterminate">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE" Easing="Linear">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="translate(-50%,0)" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="translate(100%,0)" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
