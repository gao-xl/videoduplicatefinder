<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="40">
            <StackPanel Spacing="16">
                <TextBlock FontFamily="{StaticResource SystemFontFamily}" Text="System Font Family" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <Styles.Resources>
        <!-- ===== macOS 极简布局参数 ===== -->
        <Thickness x:Key="PageMargin">48 0</Thickness>
        <FontFamily x:Key="SystemFontFamily">Segoe UI, SF Pro Display, -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial</FontFamily>
        <FontFamily x:Key="MonospaceFontFamily">SF Mono, Consolas, JetBrains Mono, Menlo, monospace</FontFamily>
        
        <!-- 间距系统 - macOS 宽敞风格 -->
        <Thickness x:Key="SpacingXS">4</Thickness>
        <Thickness x:Key="SpacingSM">8</Thickness>
        <Thickness x:Key="SpacingMD">16</Thickness>
        <Thickness x:Key="SpacingLG">24</Thickness>
        <Thickness x:Key="SpacingXL">32</Thickness>
        <Thickness x:Key="SpacingXXL">48</Thickness>
        
        <!-- 圆角系统 -->
        <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
        <CornerRadius x:Key="CornerRadiusMD">8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusLG">12</CornerRadius>
    </Styles.Resources>

    <!-- 模块化样式导入 -->
    <StyleInclude Source="avares://VDF.GUI/Styles/_Colors.xaml" />
    <StyleInclude Source="avares://VDF.GUI/Styles/_Animations.xaml" />
    <StyleInclude Source="avares://VDF.GUI/Styles/_Buttons.xaml" />
    <StyleInclude Source="avares://VDF.GUI/Styles/_Badges.xaml" />
    <StyleInclude Source="avares://VDF.GUI/Styles/_GroupHeader.xaml" />
    <StyleInclude Source="avares://VDF.GUI/Styles/_Cards.xaml" />

    <!-- ===== 全局字体设置 ===== -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Regular" />
    </Style>
    
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    
    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== 窗口最大化状态 ===== -->
    <Style Selector="Window[WindowState=Maximized]">
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- ===== macOS 控件样式 ===== -->

    <!-- TextBox - 大字体、宽敞间距 -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="Padding" Value="12 8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AcceptsReturn" Value="False" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>

    <!-- ComboBox -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="Padding" Value="12 8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>

    <!-- CheckBox - 大字体、宽敞间距 -->
    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8 6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- TabControl - macOS 分段式风格 -->
    <Style Selector="TabControl">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="16 10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ListBox - 大字体、宽敞间距 -->
    <Style Selector="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="12 10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    </Style>

    <!-- ProgressBar - macOS 简洁风格 -->
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
    </Style>

    <!-- NumericUpDown -->
    <Style Selector="NumericUpDown">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Padding" Value="12 8" />
    </Style>

    <!-- Menu - macOS 菜单风格 -->
    <Style Selector="Menu">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8 6" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10 6" />
    </Style>

    <!-- Separator -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="0 8" />
    </Style>

    <!-- ToolTip - macOS 提示风格 -->
    <Style Selector="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10 6" />
    </Style>

    <!-- ===== 布局辅助样式 ===== -->

    <!-- 设置面板 - 宽敞间距 -->
    <Style Selector="Border.settings-panel">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMD}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0 8" />
    </Style>

    <!-- 工具栏 -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16 12" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- 过滤栏 -->
    <Style Selector="Border.filter-bar">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="16 12" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- 状态栏 -->
    <Style Selector="Border.status-bar">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16 10" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- 对话框根 -->
    <Style Selector="Border.dialog-root">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 对话框操作栏 -->
    <Style Selector="Border.dialog-actions">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="20 16" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- 分隔线 -->
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="0 16" />
    </Style>
    <Style Selector="Border.vdivider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="8 0" />
    </Style>

    <!-- ===== 文字辅助样式 ===== -->

    <!-- 标题 -->
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0 16 0 8" />
    </Style>

    <!-- 提示文字 -->
    <Style Selector="TextBlock.section-hint">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0 4 0 12" />
    </Style>

    <!-- 字段标签 -->
    <Style Selector="TextBlock.field-label">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0 12 0 6" />
    </Style>

    <!-- 字段组 -->
    <Style Selector="StackPanel.field-group">
        <Setter Property="Spacing" Value="10" />
        <Setter Property="Margin" Value="0 8" />
    </Style>

    <!-- DataGrid -->
    <Style Selector="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource SystemFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Border#PART_RowRoot">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Border#PART_RowRoot">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    </Style>
</Styles>