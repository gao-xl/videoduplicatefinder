<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- ===== macOS 极简现代风格 - 单色调配色 ===== -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ===== 亮色主题 (macOS Light) ===== -->
                <ResourceDictionary x:Key="Light">
                    <!-- 主色调 - 单一蓝色强调 -->
                    <SolidColorBrush x:Key="PrimaryBrush">#007AFF</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHoverBrush">#0066CC</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryLightBrush">#E5F1FF</SolidColorBrush>
                    
                    <!-- 强调色 - 仅用于特殊标记 -->
                    <SolidColorBrush x:Key="AccentBrush">#FF3B30</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentLightBrush">#FFE5E5</SolidColorBrush>
                    
                    <!-- 状态色 -->
                    <SolidColorBrush x:Key="SuccessBrush">#34C759</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBrush">#FF9500</SolidColorBrush>
                    <SolidColorBrush x:Key="ErrorBrush">#FF3B30</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBrush">#FF3B30</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBrush">#5AC8FA</SolidColorBrush>
                    
                    <!-- 背景色层 - 纯净灰白 -->
                    <SolidColorBrush x:Key="SurfacePrimaryBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceSecondaryBrush">#F5F5F7</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceTertiaryBrush">#E8E8ED</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceElevatedBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceAltBrush">#F0F0F5</SolidColorBrush>
                    
                    <!-- 边框色 - 极细边框 -->
                    <SolidColorBrush x:Key="BorderSubtleBrush">#E5E5EA</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderDefaultBrush">#D1D1D6</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderStrongBrush">#C7C7CC</SolidColorBrush>
                    
                    <!-- 文字颜色 - 清晰层次 -->
                    <SolidColorBrush x:Key="TextPrimaryBrush">#1D1D1F</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryBrush">#6E6E73</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiaryBrush">#AEAEB2</SolidColorBrush>
                    <SolidColorBrush x:Key="TextDisabledBrush">#C7C7CC</SolidColorBrush>
                    <SolidColorBrush x:Key="TextInverseBrush">#FFFFFF</SolidColorBrush>
                    
                    <!-- 行背景色 -->
                    <SolidColorBrush x:Key="RowHoverBrush">#F5F5F7</SolidColorBrush>
                    <SolidColorBrush x:Key="RowSelectedBrush">#E5F1FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RowAltBrush">#FAFAFA</SolidColorBrush>
                    
                    <!-- 按钮颜色 -->
                    <SolidColorBrush x:Key="ButtonPrimaryBackground">#007AFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPrimaryForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPrimaryHoverBackground">#0066CC</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPrimaryPressedBackground">#0055AA</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerBackground">#FF3B30</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerHoverBackground">#E6332A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerPressedBackground">#CC2D26</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonGhostForegroundBrush">#1D1D1F</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonGhostBorderBrush">#D1D1D6</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonGhostHoverBackground">#F5F5F7</SolidColorBrush>
                    
                    <!-- 卡片颜色 -->
                    <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBorderBrush">#E5E5EA</SolidColorBrush>
                    <SolidColorBrush x:Key="CardHoverBorderBrush">#D1D1D6</SolidColorBrush>
                    <SolidColorBrush x:Key="CardSelectedBorderBrush">#007AFF</SolidColorBrush>
                    
                    <!-- 徽章颜色 -->
                    <SolidColorBrush x:Key="BadgeHighBackground">#E5F9E8</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeHighForeground">#34C759</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeMediumBackground">#E5F1FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeMediumForeground">#007AFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLowBackground">#FFF5E5</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLowForeground">#FF9500</SolidColorBrush>
                    <SolidColorBrush x:Key="BestBadgeBackground">#007AFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BestBadgeForeground">#FFFFFF</SolidColorBrush>
                    
                    <!-- 分组标题 -->
                    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush">#F5F5F7</SolidColorBrush>
                    
                    <!-- 骨架屏 shimmer -->
                    <SolidColorBrush x:Key="SkeletonShimmerBrush">#15E5E5EA</SolidColorBrush>
                    
                    <!-- 图标色 -->
                    <SolidColorBrush x:Key="IconForegroundBrush">#6E6E73</SolidColorBrush>
                    <SolidColorBrush x:Key="IconForegroundSubtleBrush">#AEAEB2</SolidColorBrush>
                    
                    <!-- 警告/危险文字色 -->
                    <SolidColorBrush x:Key="WarningTextBrush">#FF9500</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerTextBrush">#FF3B30</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessTextBrush">#34C759</SolidColorBrush>
                    
                    <!-- 兼容资源名 -->
                    <SolidColorBrush x:Key="ButtonForegroundBrush">#6E6E73</SolidColorBrush>
                    <SolidColorBrush x:Key="Container1BackgroundBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Container1BorderBrush">#E5E5EA</SolidColorBrush>
                    <SolidColorBrush x:Key="Container2BackgroundBrush">#F5F5F7</SolidColorBrush>
                    <SolidColorBrush x:Key="Container2BorderBrush">#D1D1D6</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushEmphasizedAccent">#007AFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushSolidAccent">#007AFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushSolidWarning">#FF9500</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushEmphasizedDanger">#FF3B30</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlForegroundBrushSoftWarning">#FF9500</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush">#D1D1D6</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlHighlightBaseLowBrush">#E5E5EA</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush">#1D1D1F</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeBlackLowBrush">#F5F5F7</SolidColorBrush>
                </ResourceDictionary>

                <!-- ===== 暗色主题 (macOS Dark) ===== -->
                <ResourceDictionary x:Key="Dark">
                    <!-- 主色调 -->
                    <SolidColorBrush x:Key="PrimaryBrush">#0A84FF</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHoverBrush">#409CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryLightBrush">#1C3A5F</SolidColorBrush>
                    
                    <!-- 强调色 -->
                    <SolidColorBrush x:Key="AccentBrush">#FF453A</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentLightBrush">#3D2A2A</SolidColorBrush>
                    
                    <!-- 状态色 -->
                    <SolidColorBrush x:Key="SuccessBrush">#32D74B</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBrush">#FFD60A</SolidColorBrush>
                    <SolidColorBrush x:Key="ErrorBrush">#FF453A</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBrush">#FF453A</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBrush">#64D2FF</SolidColorBrush>
                    
                    <!-- 背景色层 - 深灰黑 -->
                    <SolidColorBrush x:Key="SurfacePrimaryBrush">#1C1C1E</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceSecondaryBrush">#2C2C2E</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceTertiaryBrush">#3A3A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceElevatedBrush">#2C2C2E</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceAltBrush">#252528</SolidColorBrush>
                    
                    <!-- 边框色 -->
                    <SolidColorBrush x:Key="BorderSubtleBrush">#3A3A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderDefaultBrush">#48484A</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderStrongBrush">#636366</SolidColorBrush>
                    
                    <!-- 文字颜色 -->
                    <SolidColorBrush x:Key="TextPrimaryBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryBrush">#AEAEB2</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiaryBrush">#8E8E93</SolidColorBrush>
                    <SolidColorBrush x:Key="TextDisabledBrush">#48484A</SolidColorBrush>
                    <SolidColorBrush x:Key="TextInverseBrush">#1C1C1E</SolidColorBrush>
                    
                    <!-- 行背景色 -->
                    <SolidColorBrush x:Key="RowHoverBrush">#2C2C2E</SolidColorBrush>
                    <SolidColorBrush x:Key="RowSelectedBrush">#1C3A5F</SolidColorBrush>
                    <SolidColorBrush x:Key="RowAltBrush">#252528</SolidColorBrush>
                    
                    <!-- 按钮颜色 -->
                    <SolidColorBrush x:Key="ButtonPrimaryBackground">#0A84FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPrimaryForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPrimaryHoverBackground">#409CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPrimaryPressedBackground">#0070E0</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerBackground">#FF453A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerHoverBackground">#FF6961</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDangerPressedBackground">#E63935</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonGhostForegroundBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonGhostBorderBrush">#48484A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonGhostHoverBackground">#3A3A3C</SolidColorBrush>
                    
                    <!-- 卡片颜色 -->
                    <SolidColorBrush x:Key="CardBackgroundBrush">#2C2C2E</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBorderBrush">#3A3A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="CardHoverBorderBrush">#48484A</SolidColorBrush>
                    <SolidColorBrush x:Key="CardSelectedBorderBrush">#0A84FF</SolidColorBrush>
                    
                    <!-- 徽章颜色 -->
                    <SolidColorBrush x:Key="BadgeHighBackground">#1A3D1F</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeHighForeground">#32D74B</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeMediumBackground">#1C3A5F</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeMediumForeground">#0A84FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLowBackground">#3D2A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLowForeground">#FFD60A</SolidColorBrush>
                    <SolidColorBrush x:Key="BestBadgeBackground">#0A84FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BestBadgeForeground">#FFFFFF</SolidColorBrush>
                    
                    <!-- 分组标题 -->
                    <SolidColorBrush x:Key="GroupHeaderBackgroundBrush">#2C2C2E</SolidColorBrush>
                    
                    <!-- 骨架屏 shimmer -->
                    <SolidColorBrush x:Key="SkeletonShimmerBrush">#153A3A3C</SolidColorBrush>
                    
                    <!-- 图标色 -->
                    <SolidColorBrush x:Key="IconForegroundBrush">#AEAEB2</SolidColorBrush>
                    <SolidColorBrush x:Key="IconForegroundSubtleBrush">#8E8E93</SolidColorBrush>
                    
                    <!-- 警告/危险文字色 -->
                    <SolidColorBrush x:Key="WarningTextBrush">#FFD60A</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerTextBrush">#FF453A</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessTextBrush">#32D74B</SolidColorBrush>
                    
                    <!-- 兼容资源名 -->
                    <SolidColorBrush x:Key="ButtonForegroundBrush">#AEAEB2</SolidColorBrush>
                    <SolidColorBrush x:Key="Container1BackgroundBrush">#1C1C1E</SolidColorBrush>
                    <SolidColorBrush x:Key="Container1BorderBrush">#3A3A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="Container2BackgroundBrush">#2C2C2E</SolidColorBrush>
                    <SolidColorBrush x:Key="Container2BorderBrush">#48484A</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushEmphasizedAccent">#0A84FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushSolidAccent">#0A84FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushSolidWarning">#FFD60A</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBackgroundBrushEmphasizedDanger">#FF453A</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlForegroundBrushSoftWarning">#FFD60A</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush">#48484A</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlHighlightBaseLowBrush">#3A3A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeBlackLowBrush">#3A3A3C</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ===== 默认回退资源 ===== -->
            <SolidColorBrush x:Key="PrimaryBrush">#007AFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimaryBrush">#1D1D1F</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForegroundBrush">#6E6E73</SolidColorBrush>
            <SolidColorBrush x:Key="SurfacePrimaryBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceSecondaryBrush">#F5F5F7</SolidColorBrush>
            <SolidColorBrush x:Key="BorderDefaultBrush">#D1D1D6</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonPrimaryBackground">#007AFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonPrimaryForeground">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>