<Window
    x:Class="VDF.GUI.Views.InputBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="using:VDF.GUI.ViewModels"
    x:DataType="vm:InputBoxVM"
    Title="{Binding Title}"
    MinWidth="400"
    Width="400"
    MaxWidth="600"
    CanResize="false"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Border Classes="dialog-root">
        <StackPanel>
            <!-- Content area -->
            <StackPanel Spacing="12" Padding="24,20">
                <TextBlock
                    Text="{Binding Message}"
                    TextWrapping="Wrap"
                    FontSize="14"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel
                    IsVisible="{Binding HasReadOnlyInfo}"
                    Spacing="4">
                    <TextBlock
                        Classes="field-label"
                        Text="Current file:" />
                    <Border
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        CornerRadius="6"
                        Padding="10,6">
                        <SelectableTextBlock
                            Text="{Binding ReadOnlyInfo}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBox
                    x:Name="TextBoxInput"
                    Text="{Binding Input}"
                    TextWrapping="Wrap"
                    PlaceholderText="{Binding WaterMark}" />
            </StackPanel>
            <!-- Action bar -->
            <Border Classes="dialog-actions">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button
                        Classes="btn-primary"
                        MinWidth="100"
                        Command="{Binding OKCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.OK]}"
                        IsDefault="{Binding HasOKButton}"
                        IsVisible="{Binding HasOKButton}" />
                    <Button
                        Classes="btn-primary"
                        MinWidth="100"
                        Command="{Binding YesCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Yes]}"
                        IsDefault="{Binding HasYesButton}"
                        IsVisible="{Binding HasYesButton}" />
                    <Button
                        Classes="btn-ghost"
                        MinWidth="100"
                        Command="{Binding NoCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.No]}"
                        IsCancel="{Binding HasNoButton}"
                        IsVisible="{Binding HasNoButton}" />
                    <Button
                        Classes="btn-ghost"
                        MinWidth="100"
                        Command="{Binding CancelCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Cancel]}"
                        IsCancel="{Binding HasCancelButton}"
                        IsVisible="{Binding HasCancelButton}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>