<Window
    x:Class="VDF.GUI.Views.MessageBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mvvm="clr-namespace:VDF.GUI.Mvvm;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="using:VDF.GUI.ViewModels"
    x:DataType="vm:MessageBoxVM"
    Title="{Binding Title}"
    MinWidth="400"
    MaxWidth="600"
    MaxHeight="600"
    CanResize="false"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">
    <Border Classes="dialog-root">
        <StackPanel>
            <!-- Content area -->
            <ScrollViewer x:Name="ScrollViewerMessageboxContent" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{Binding Message}"
                    TextWrapping="Wrap"
                    FontSize="14"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            </ScrollViewer>
            <!-- Action bar -->
            <Border Classes="dialog-actions">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button
                        x:Name="OkButton"
                        Classes="btn-primary"
                        MinWidth="100"
                        Command="{Binding OKCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.OK]}"
                        IsVisible="{Binding HasOKButton}" />
                    <Button
                        x:Name="YesButton"
                        Classes="btn-primary"
                        MinWidth="100"
                        Command="{Binding YesCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Yes]}"
                        IsVisible="{Binding HasYesButton}" />
                    <Button
                        x:Name="NoButton"
                        Classes="btn-ghost"
                        MinWidth="100"
                        Command="{Binding NoCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.No]}"
                        IsVisible="{Binding HasNoButton}" />
                    <Button
                        x:Name="CancelButton"
                        Classes="btn-ghost"
                        MinWidth="100"
                        Command="{Binding CancelCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Cancel]}"
                        IsVisible="{Binding HasCancelButton}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>