<Window
    x:Class="VDF.GUI.Views.ExpressionBuilder"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:VDF.GUI.Data"
    xmlns:vm="using:VDF.GUI.ViewModels"
    x:DataType="vm:ExpressionBuilderVM"
    Title="{Binding Source={x:Static local:App.Lang}, Path=[ExpressionBuilder.Title]}"
    MinWidth="400"
    MaxWidth="600"
    d:DesignHeight="450"
    d:DesignWidth="800"
    CanResize="false"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Border Classes="dialog-root">
        <StackPanel>
            <!-- Content area -->
            <StackPanel Spacing="12" Padding="24,20">
                <!-- Available properties -->
                <Border
                    Background="{DynamicResource SurfaceTertiaryBrush}"
                    CornerRadius="8"
                    Padding="12"
                    MaxHeight="200">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            IsReadOnly="True"
                            Text="{Binding AvailableProperties}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                    </ScrollViewer>
                </Border>

                <!-- Expression input -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Classes="field-label"
                        Text="{Binding Source={x:Static local:App.Lang}, Path=[ExpressionBuilder.ExpressionLabel]}" />
                    <AutoCompleteBox
                        x:Name="ExpressionHistoryInput"
                        ItemsSource="{Binding ExpressionHistory}"
                        Text="{Binding ExpressionText, Mode=TwoWay}" />
                </StackPanel>

                <!-- Preset selector -->
                <Border Classes="settings-panel" Padding="12">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Classes="field-label"
                            VerticalAlignment="Center"
                            Text="{Binding Source={x:Static local:App.Lang}, Path=[Preset.Label]}" />
                        <ComboBox
                            Grid.Column="2"
                            ItemsSource="{Binding ExpressionPresets}"
                            SelectedItem="{Binding SelectedPreset}">
                            <ComboBox.DisplayMemberBinding>
                                <Binding Path="Name" DataType="data:ExpressionPreset" />
                            </ComboBox.DisplayMemberBinding>
                        </ComboBox>
                        <Button
                            Grid.Column="4"
                            Classes="btn-ghost"
                            Command="{Binding SavePresetCommand}"
                            Content="{Binding Source={x:Static local:App.Lang}, Path=[Preset.Save]}" />
                        <Button
                            Grid.Column="6"
                            Classes="btn-ghost"
                            Command="{Binding DeletePresetCommand}"
                            Content="{Binding Source={x:Static local:App.Lang}, Path=[Preset.Delete]}" />
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Action bar -->
            <Border Classes="dialog-actions">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button
                        Classes="btn-primary"
                        MinWidth="100"
                        Command="{Binding OKCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.OK]}" />
                    <Button
                        Classes="btn-ghost"
                        MinWidth="100"
                        Command="{Binding CancelCommand}"
                        Content="{Binding Source={x:Static local:App.Lang}, Path=[Dialog.Cancel]}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
